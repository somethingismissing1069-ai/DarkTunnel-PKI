# DarkTunnel PKI Web - Backend Environment Configuration
# Copy this file to .env and update values for your environment

# Server port
PORT=3001

# JWT secret key - MUST be changed in production (minimum 256 bits of entropy)
JWT_SECRET=change_this_to_a_secure_random_string_at_least_32_characters

# SQLite database file path (relative to backend directory)
DB_PATH=./data/darktunnel.db
